{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build GDExtension (Debug)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/cpp/build.ps1",
        "-Configuration", "Debug"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": {
        "base": "$msCompile",
        "fileLocation": ["relative", "${workspaceFolder}/cpp"]
      }
    }
  ]
}
